package root

import (
	"fmt"
	"log/slog"
	"math/rand/v2"
	"net/http"
	"strconv"
	"strings"

	"github.com/go-chi/chi/v5"
	"github.com/gorilla/sessions"
	"github.com/nats-io/nats.go"
	"github.com/starfederation/datastar-go/datastar"
)

// Snow globe: shake your phone and it snows on every screen, subtly, like shaking a real snow globe.
//
// The phone part is the <snow-globe> Rocket component (static/snow-globe.js): it reads the motion sensor, shows
// an immediate puff of snow on the shaking phone, and when the shaking stops emits `shaken` with the number
// of shakes. The markup below turns that into a POST. The server publishes one snowSubject message per burst,
// and every other screen's snow stream appends a Snowfall whose starting swirl grows with the number of shakes,
// then settles and falls slowly. Like emoji balloons, a shake is an event, not state: nothing is stored.

const snowSubject = "snow.shaken"

// A burst can claim at most this many shakes, so a single phone cannot fill every screen with snow.
const maxShakesPerBurst = 20

// The phone shows only the first few flakes (snow_globe.css); the big screen shows them all.
const flakesPerShake, maxFlakes = 3, 24

func SnowGlobeRoutes(router chi.Router, nc *nats.Conn, store sessions.Store, logger *slog.Logger) {
	router.Post("/snow/shake", func(w http.ResponseWriter, r *http.Request) {
		var signals struct {
			Shakes int `json:"shakes"`
		}
		if err := datastar.ReadSignals(r, &signals); err != nil || signals.Shakes < 1 {
			http.Error(w, "a shake needs a positive number of shakes", http.StatusBadRequest)
			return
		}
		sessionID, err := attendeeSessionID(store, w, r)
		if err != nil {
			logger.Error("failed to get attendee session", slog.String("error", err.Error()))
			http.Error(w, http.StatusText(http.StatusInternalServerError), http.StatusInternalServerError)
			return
		}
		shakes := min(signals.Shakes, maxShakesPerBurst)
		// The sender's session travels along, so the shaking phone, which already showed its own snow, skips it.
		if err := nc.Publish(snowSubject, []byte(fmt.Sprintf("%d %s", shakes, sessionID))); err != nil {
			logger.Error("failed to publish snow", slog.String("error", err.Error()))
			http.Error(w, http.StatusText(http.StatusInternalServerError), http.StatusInternalServerError)
			return
		}
		w.WriteHeader(http.StatusNoContent)
	})

	router.Get("/snow/sse", func(w http.ResponseWriter, r *http.Request) {
		sessionID, err := attendeeSessionID(store, w, r)
		if err != nil {
			logger.Error("failed to get attendee session", slog.String("error", err.Error()))
			http.Error(w, http.StatusText(http.StatusInternalServerError), http.StatusInternalServerError)
			return
		}
		bursts := make(chan *nats.Msg, 64)
		subscription, err := nc.ChanSubscribe(snowSubject, bursts)
		if err != nil {
			logger.Error("failed to subscribe to snow", slog.String("error", err.Error()))
			http.Error(w, http.StatusText(http.StatusInternalServerError), http.StatusInternalServerError)
			return
		}
		defer func() {
			if err := subscription.Unsubscribe(); err != nil {
				logger.Error("failed to unsubscribe from snow", slog.String("error", err.Error()))
			}
		}()

		// NewSSE sends the response headers; from here on, failures are logged and end the stream.
		sse := datastar.NewSSE(w, r, compressedStream())
		for {
			select {
			case <-r.Context().Done():
				return
			case burst := <-bursts:
				shakesText, senderSessionID, _ := strings.Cut(string(burst.Data), " ")
				if senderSessionID == sessionID {
					continue
				}
				shakes, err := strconv.Atoi(shakesText)
				if err != nil {
					logger.Error("invalid snow message", slog.String("message", string(burst.Data)))
					continue
				}
				if err := sse.PatchElementTempl(Snowfall(shakes), datastar.WithSelector("body"), datastar.WithModeAppend()); err != nil {
					logger.Error("failed to send snowfall", slog.String("error", err.Error()))
					return
				}
			}
		}
	})
}

// snowflake holds one flake's random variation, so the flakes swirl, fall and sway out of step.
type snowflake struct {
	X, Top, Drift, Size float64 // where it starts (%), its sideways swirl per shake (vw), its size (rem)
	DelayMs, SwirlMs    int     // when its swirl starts, and how long the swirl takes to slow down
	FallDelayMs, FallMs int     // when its fall starts (while the swirl is still slowing down), and how long it takes
	Fall, FallDrift     float64 // how far down (vh) and sideways (vw, a little wind) it falls
	Sway, SwayMs        float64 // how far (vw) and how slowly (ms) it sways from side to side while falling
}

func (flake snowflake) style() string {
	return fmt.Sprintf("--x: %.1f%%; --top: %.1f%%; --drift: %.2fvw; --size: %.2f; --delay: %dms; --swirl-duration: %dms; "+
		"--fall-delay: %dms; --duration: %dms; --fall: %.0fvh; --fall-drift: %.2fvw; --sway: %.2fvw; --sway-duration: %.0fms;",
		flake.X, flake.Top, flake.Drift, flake.Size, flake.DelayMs, flake.SwirlMs,
		flake.FallDelayMs, flake.FallMs, flake.Fall, flake.FallDrift, flake.Sway, flake.SwayMs)
}

// randomSnowflakes scatters flakes along the top of the screen; static/snow-globe.js does the same for the local puff.
func randomSnowflakes(shakes int) []snowflake {
	random := func(low, high float64) float64 { return low + rand.Float64()*(high-low) }
	flakes := make([]snowflake, min(shakes*flakesPerShake, maxFlakes))
	for i := range flakes {
		delayMs := rand.IntN(400)
		flakes[i] = snowflake{
			X:           random(5, 95),
			Top:         random(0, 10),
			Drift:       random(-3, 3),
			Size:        random(0.6, 1.2),
			DelayMs:     delayMs,
			SwirlMs:     1000 + rand.IntN(800),
			FallDelayMs: delayMs + 600 + rand.IntN(800),
			FallMs:      10000 + rand.IntN(4000),
			Fall:        random(75, 95),
			FallDrift:   random(-2, 2),
			Sway:        random(1, 3),
			SwayMs:      random(2500, 4500),
		}
	}
	return flakes
}

// snowfallInit starts a snowfall's animations at the moment it arrived, then removes it when it has fallen.
// A CSS animation otherwise starts when the browser first draws it: in a window that is not drawn (on another
// workspace) every snowfall would wait, then start all at once when the window is drawn again, and be cut off
// by the removal, which counts from the arrival. With the start time set, the snow falls by the clock.
const snowfallInit = `const arrivedAt = performance.now(); el.getAnimations({subtree: true}).forEach((animation) => animation.startTime = arrivedAt); setTimeout(() => el.remove(), 18000)`

// Snowfall falls by the clock and removes itself, through a Datastar expression; no component needed. Each flake is
// three nested elements, one per movement, so the movements can overlap (snow_globe.css): swirl, fall, sway.
templ Snowfall(shakes int) {
	<div class="snowfall" style={ fmt.Sprintf("--energy: %d;", shakes) } data-init={ snowfallInit }>
		for _, flake := range randomSnowflakes(shakes) {
			<span class="snowflake" style={ flake.style() }><span class="snowflake-fall"><span class="snowflake-sway">❄</span></span></span>
		}
	</div>
}

// SnowGlobe is placed next to #root-page-wrapper, not inside it, so page updates never morph it (or the iOS
// permission button the component adds) away. The Datastar attributes sit on a wrapper, not on <snow-globe>:
// Rocket rewrites Datastar actions on its own element into calls to the component's own actions.
templ SnowGlobe(inviteKey string) {
	<div
		class="snow-globe"
		data-signals="{ shakes: 0 }"
		data-init={ fmt.Sprintf("@get('/%s/root/api/snow/sse',{requestCancellation: 'disabled'})", inviteKey) }
		data-on:shaken={ fmt.Sprintf("$shakes = evt.detail.count; @post('/%s/root/api/snow/shake',{requestCancellation: 'disabled'})", inviteKey) }
	>
		<snow-globe></snow-globe>
	</div>
}
