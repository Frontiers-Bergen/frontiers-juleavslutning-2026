package root

import (
	"database/sql"
	"fmt"
	"log/slog"
	"net/http"

	"github.com/frontiers-bergen/frontiers-juleavslutning-2026/components"
	"github.com/go-chi/chi/v5"
	"github.com/gorilla/sessions"
	"github.com/nats-io/nats.go"
	datastar "github.com/starfederation/datastar-go/datastar"
)

const presenterSessionName = "presenter-auth"

func RootLayoutRoute(
	router chi.Router,
	db *sql.DB,
	store sessions.Store,
	logger *slog.Logger,
	nc *nats.Conn,
	tugOfWarRules TugOfWarRules,
) {
	router.Get("/", func(w http.ResponseWriter, r *http.Request) {
		ctx := r.Context()

		sessionID, err := attendeeSessionID(store, w, r)
		if err != nil {
			logger.Error("failed to get attendee session", slog.String("error", err.Error()))
			http.Error(w, http.StatusText(http.StatusInternalServerError), http.StatusInternalServerError)
			return
		}

		inviteKey := chi.URLParam(r, "inviteKey")

		sseURL := fmt.Sprintf("/%s/root/api", inviteKey)
		if r.URL.RawQuery != "" {
			sseURL = sseURL + "?" + r.URL.RawQuery
		}
		dataInit := fmt.Sprintf("@get('%s',{requestCancellation: 'disabled'})", sseURL)

		isPresenter := isPresenterFromSession(r, store)

		renderErr := components.BaseLayout(
			"Frontiers Meetup",
			rootPageFirstLoad(db, inviteKey, dataInit, isPresenter, sessionID),
		).Render(ctx, w)
		if renderErr != nil {
			logger.Error("failed to render root page", slog.String("error", renderErr.Error()))
		}
	})

	InviteQRCodeRoute(router, logger)

	router.Route("/root", func(rootRouter chi.Router) {
		rootRouter.Route("/api", func(rootApiRouter chi.Router) {
			rootApiRouter.Get("/", func(w http.ResponseWriter, r *http.Request) {
				sessionID, err := attendeeSessionID(store, w, r)
				if err != nil {
					logger.Error("failed to get attendee session", slog.String("error", err.Error()))
					http.Error(w, http.StatusText(http.StatusInternalServerError), http.StatusInternalServerError)
					return
				}

				// Subscribe before the first patch, so no change falls between the two.
				deckChanges := make(chan *nats.Msg, 64)
				subscription, err := nc.ChanSubscribe(deckChangedSubject, deckChanges)
				if err != nil {
					logger.Error("failed to subscribe to deck changes", slog.String("error", err.Error()))
					http.Error(w, http.StatusText(http.StatusInternalServerError), http.StatusInternalServerError)
					return
				}
				defer func() {
					if err := subscription.Unsubscribe(); err != nil {
						logger.Error("failed to unsubscribe from deck changes", slog.String("error", err.Error()))
					}
				}()

				inviteKey := chi.URLParam(r, "inviteKey")
				isPresenter := isPresenterFromSession(r, store)

				// NewSSE sends the response headers immediately. From here on, failures can only be
				// logged and end the stream; http.Error would write a second, ignored header.
				// Compressed: on a long-lived stream each further page update is nearly identical to the previous one
				// and costs tens of bytes, which is what makes re-rendering on every change cheap (the Datastar way).
				sse := datastar.NewSSE(w, r, compressedStream())
				if err := sse.PatchElementTempl(rootPage(db, inviteKey, isPresenter, sessionID)); err != nil {
					logStreamFailure(logger, r, "failed to send initial page patch", err)
					return
				}

				for {
					select {
					case <-r.Context().Done():
						return
					case <-deckChanges:
						// Changes already waiting are in this render too: it reads everything from SQLite.
						for range len(deckChanges) {
							<-deckChanges
						}
						if err := sse.PatchElementTempl(rootPage(db, inviteKey, isPresenter, sessionID)); err != nil {
							logStreamFailure(logger, r, "failed to send page patch", err)
							return
						}
					}
				}
			})

			IncrementEmojiRoute(rootApiRouter, db, nc, store, logger)
			TopNavigationRoutes(db, rootApiRouter, nc, store)

			PollVoteRoutes(db, rootApiRouter, nc, store)
			TugOfWarRoutes(rootApiRouter, db, nc, store, logger, tugOfWarRules)
			SnowGlobeRoutes(rootApiRouter, nc, store, logger)
		})
	})
}

func isPresenterFromSession(r *http.Request, store sessions.Store) bool {
	sess, err := store.Get(r, presenterSessionName)
	if err != nil {
		return false
	}

	v, ok := sess.Values["presenter"].(bool)
	return ok && v
}

templ rootPageFirstLoad(
	db *sql.DB,
	inviteKey string,
	dataInit string,
	isPresenter bool,
	sessionID string,
) {
	<div id="root-page-wrapper" data-init={ dataInit }>
		@rootPageContent(db, inviteKey, isPresenter, sessionID)
	</div>
	@SnowGlobe(inviteKey)
}

templ rootPage(
	db *sql.DB,
	inviteKey string,
	isPresenter bool,
	sessionID string,
) {
	<div id="root-page-wrapper">
		@rootPageContent(db, inviteKey, isPresenter, sessionID)
	</div>
}

templ rootPageContent(
	db *sql.DB,
	inviteKey string,
	isPresenter bool,
	sessionID string,
) {
	<div class="app">
		if isPresenter {
			<div class="presenter-layout">
				<aside class="presenter-sidebar" aria-label="Slide list">
					@PresenterSlideList(db, inviteKey, sessionID)
				</aside>
				<div class="presenter-main">
					<header class="presenter-bar" aria-label="Presenter controls">
						@TopNavigation(db, inviteKey, sessionID)
					</header>
					<main class="stage" aria-label="Presentation">
						@ActiveSlide(db, inviteKey, sessionID, isPresenter)
					</main>
					<footer class="reactions" aria-label="Reactions">
						@EmojiVoteWidget(inviteKey)
					</footer>
				</div>
			</div>
		} else {
			<main class="stage" aria-label="Presentation">
				@ActiveSlide(db, inviteKey, sessionID, isPresenter)
			</main>
			<footer class="reactions" aria-label="Reactions">
				@EmojiVoteWidget(inviteKey)
			</footer>
		}
	</div>
}
