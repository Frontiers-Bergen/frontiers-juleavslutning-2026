package root

import (
	"database/sql"
	"fmt"
	"net/http"
	"net/url"
	"time"

	"github.com/frontiers-bergen/frontiers-juleavslutning-2026/helpers"
	"github.com/go-chi/chi/v5"
	"github.com/gorilla/sessions"
	"github.com/nats-io/nats.go/jetstream"
)

type PollOption struct {
	Key      string
	Text     string
	ImageURL string
}

type PollDefinition struct {
	Key              string
	QuestionText     string
	QuestionImageURL string
	Options          []PollOption
}

var pollDefinitions = map[string]PollDefinition{
	// The app name vote at the workshop (see README). The winner becomes the name on the big screen.
	"app-name": {
		Key:          "app-name",
		QuestionText: "What should we call this app?",
		Options: []PollOption{
			{Key: "rage-against-the-debounce", Text: "Rage Against the Debounce"},
			{Key: "last-christmas", Text: "Last Christmas I Gave You My Clicks"},
			{Key: "its-tiiime", Text: "It's Tiiime"},
			{Key: "smash-the-halls", Text: "Smash the Halls"},
		},
	},
}

func MustPoll(key string) PollDefinition {
	p, ok := pollDefinitions[key]
	if !ok {
		panic("unknown poll key: " + key)
	}
	return p
}

func pollHasOption(poll PollDefinition, optionKey string) bool {
	for _, opt := range poll.Options {
		if opt.Key == optionKey {
			return true
		}
	}
	return false
}

func getMyPollVote(db *sql.DB, inviteKey, pollKey, sessionID string) (string, error) {
	var optionKey string
	err := db.QueryRow(
		`SELECT option_key FROM poll_votes WHERE invite_key = ? AND poll_key = ? AND session_id = ?`,
		inviteKey, pollKey, sessionID,
	).Scan(&optionKey)

	if err == sql.ErrNoRows {
		return "", nil
	}
	if err != nil {
		return "", err
	}

	return optionKey, nil
}

func upsertPollVote(db *sql.DB, inviteKey, pollKey, sessionID, optionKey string) error {
	nowUnix := time.Now().Unix()
	_, err := db.Exec(`
		INSERT INTO poll_votes (invite_key, poll_key, session_id, option_key, voted_at_unix)
		VALUES (?, ?, ?, ?, ?)
		ON CONFLICT(invite_key, poll_key, session_id)
		DO UPDATE SET option_key = excluded.option_key, voted_at_unix = excluded.voted_at_unix
	`, inviteKey, pollKey, sessionID, optionKey, nowUnix)
	return err
}

func PollVoteRoutes(db *sql.DB, router chi.Router, kv jetstream.KeyValue, store sessions.Store) {
	router.Post("/poll/vote", func(w http.ResponseWriter, r *http.Request) {
		inviteKey := chi.URLParam(r, "inviteKey")
		pollKey := r.URL.Query().Get("poll")
		optionKey := r.URL.Query().Get("option")

		if inviteKey == "" {
			http.Error(w, "missing inviteKey", http.StatusBadRequest)
			return
		}
		if pollKey == "" {
			http.Error(w, "missing poll", http.StatusBadRequest)
			return
		}
		if optionKey == "" {
			http.Error(w, "missing option", http.StatusBadRequest)
			return
		}

		poll, ok := pollDefinitions[pollKey]
		if !ok {
			http.Error(w, "unknown poll", http.StatusBadRequest)
			return
		}
		if !pollHasOption(poll, optionKey) {
			http.Error(w, "unknown option", http.StatusBadRequest)
			return
		}

		sessionID, _, err := helpers.LoadOrCreateState(w, r, kv, store)
		if err != nil {
			http.Error(w, "failed to load or create session: "+err.Error(), http.StatusInternalServerError)
			return
		}

		if err := upsertPollVote(db, inviteKey, pollKey, sessionID, optionKey); err != nil {
			http.Error(w, "failed to save vote: "+err.Error(), http.StatusInternalServerError)
			return
		}

		if err := helpers.BroadcastUpdate(kv, r); err != nil {
			http.Error(w, "unable to broadcast update", http.StatusInternalServerError)
			return
		}

		w.WriteHeader(http.StatusNoContent)
	})
}

func pollVotePostURL(inviteKey, pollKey, optionKey string) string {
	escapedPoll := url.QueryEscape(pollKey)
	escapedOption := url.QueryEscape(optionKey)
	return fmt.Sprintf("@post('/%s/root/api/poll/vote?poll=%s&option=%s')", inviteKey, escapedPoll, escapedOption)
}

func kahootThemeForIndex(index int) (bg string, badge string) {
	// Kahoot-ish: red, blue, yellow, green
	switch index % 4 {
	case 0:
		return "#e21b3c", "▲"
	case 1:
		return "#1368ce", "◆"
	case 2:
		return "#d89e00", "●"
	default:
		return "#26890c", "■"
	}
}

var pollStylesOnce = templ.NewOnceHandle()

templ PollSlide(db *sql.DB, inviteKey string, sessionID string, poll PollDefinition) {
	{{ selectedOptionKey, _ := getMyPollVote(db, inviteKey, poll.Key, sessionID) }}
	@pollStylesOnce.Once() {
		<style>
			@layer features {
				.poll {
					gap: 1.5rem;
					height: 100%;

					& h1 {
						margin: 0;
					}

					.poll-question {
						display: flex;
						flex-direction: column;
						gap: 0.75rem;
					}

					.poll-question-image {
						max-width: 100%;
						max-height: 40vh;
						border-radius: 16px;
						object-fit: contain;
					}

					.poll-hint {
						margin: 0;
						opacity: 0.85;
					}

					.poll-options {
						display: grid;
						grid-template-columns: repeat(2, minmax(0, 1fr));
						gap: 1rem;
						flex: 1;
					}

					/* --option-color is set per option from kahootThemeForIndex. */
					.poll-option {
						display: flex;
						align-items: stretch;
						justify-content: stretch;
						gap: 0.75rem;
						width: 100%;
						min-height: 6.5rem;
						padding: 1rem;
						border-radius: 18px;
						border: 2px solid rgba(255, 255, 255, 0.25);
						background: var(--option-color);
						color: white;
						text-align: left;
						cursor: pointer;

						&[aria-pressed="true"] {
							border: 4px solid rgba(255, 255, 255, 0.95);
							box-shadow: 0 0 0 6px rgba(255, 255, 255, 0.18);
						}
					}

					.poll-option-badge {
						display: flex;
						align-items: center;
						justify-content: center;
						width: 3rem;
						min-width: 3rem;
						font-size: 1.75rem;
						font-weight: 900;
						background: rgba(0, 0, 0, 0.18);
						border-radius: 14px;
					}

					.poll-option-body {
						display: flex;
						flex-direction: column;
						gap: 0.5rem;
						flex: 1;
						min-width: 0;
					}

					.poll-option-image {
						max-width: 100%;
						max-height: 14vh;
						border-radius: 14px;
						object-fit: cover;
						background: rgba(255, 255, 255, 0.08);
					}

					.poll-option-text {
						font-size: 1.25rem;
						font-weight: 800;
						line-height: 1.15;
						word-break: break-word;
					}

					.poll-option-selected {
						font-size: 0.95rem;
						font-weight: 700;
						opacity: 0.95;
					}
				}
			}
		</style>
	}
	<div class="slide poll">
		<div class="poll-question">
			if poll.QuestionText != "" {
				<h1>{ poll.QuestionText }</h1>
			}
			if poll.QuestionImageURL != "" {
				<img class="poll-question-image" src={ poll.QuestionImageURL } alt="Poll question image"/>
			}
			<p class="poll-hint">Pick one. You can change your vote anytime.</p>
		</div>
		<div class="poll-options">
			for i, opt := range poll.Options {
				{{ optionColor, badge := kahootThemeForIndex(i) }}
				<button
					type="button"
					class="poll-option"
					style={ "--option-color: " + optionColor }
					data-on:click={ templ.URL(pollVotePostURL(inviteKey, poll.Key, opt.Key)) }
					aria-pressed={ fmt.Sprintf("%t", opt.Key == selectedOptionKey) }
				>
					<div class="poll-option-badge">{ badge }</div>
					<div class="poll-option-body">
						if opt.ImageURL != "" {
							<img class="poll-option-image" src={ opt.ImageURL } alt=""/>
						}
						if opt.Text != "" {
							<div class="poll-option-text">{ opt.Text }</div>
						}
						if opt.Key == selectedOptionKey {
							<div class="poll-option-selected">Selected</div>
						}
					</div>
				</button>
			}
		</div>
	</div>
}
