package root

import (
	"database/sql"
	"fmt"
	"net/http"
	"net/url"
	"time"

	"github.com/go-chi/chi/v5"
	"github.com/gorilla/sessions"
	"github.com/nats-io/nats.go"
)

type PollOption struct {
	Key      string
	Text     string
	ImageURL string
}

type PollDefinition struct {
	Key              string
	QuestionText     string
	QuestionImageURL string
	Options          []PollOption
}

var pollDefinitions = map[string]PollDefinition{
	// The app name vote at the workshop (see README). The winner becomes the name on the big screen.
	"app-name": {
		Key:          "app-name",
		QuestionText: "What should we call this app?",
		Options: []PollOption{
			{Key: "rage-against-the-debounce", Text: "Rage Against the Debounce"},
			{Key: "last-christmas", Text: "Last Christmas I Gave You My Clicks"},
			{Key: "its-tiiime", Text: "It's Tiiime"},
			{Key: "smash-the-halls", Text: "Smash the Halls"},
		},
	},
}

func MustPoll(key string) PollDefinition {
	p, ok := pollDefinitions[key]
	if !ok {
		panic("unknown poll key: " + key)
	}
	return p
}

func pollHasOption(poll PollDefinition, optionKey string) bool {
	for _, opt := range poll.Options {
		if opt.Key == optionKey {
			return true
		}
	}
	return false
}

func getMyPollVote(db *sql.DB, pollKey, sessionID string) (string, error) {
	var optionKey string
	err := db.QueryRow(
		`SELECT option_key FROM poll_votes WHERE poll_key = ? AND session_id = ?`,
		pollKey, sessionID,
	).Scan(&optionKey)

	if err == sql.ErrNoRows {
		return "", nil
	}
	if err != nil {
		return "", err
	}

	return optionKey, nil
}

func upsertPollVote(db *sql.DB, pollKey, sessionID, optionKey string) error {
	nowUnix := time.Now().Unix()
	_, err := db.Exec(`
		INSERT INTO poll_votes (poll_key, session_id, option_key, voted_at_unix)
		VALUES (?, ?, ?, ?)
		ON CONFLICT(poll_key, session_id)
		DO UPDATE SET option_key = excluded.option_key, voted_at_unix = excluded.voted_at_unix
	`, pollKey, sessionID, optionKey, nowUnix)
	return err
}

func PollVoteRoutes(db *sql.DB, router chi.Router, nc *nats.Conn, store sessions.Store) {
	router.Post("/poll/vote", func(w http.ResponseWriter, r *http.Request) {
		pollKey := r.URL.Query().Get("poll")
		optionKey := r.URL.Query().Get("option")

		if pollKey == "" {
			http.Error(w, "missing poll", http.StatusBadRequest)
			return
		}
		if optionKey == "" {
			http.Error(w, "missing option", http.StatusBadRequest)
			return
		}

		poll, ok := pollDefinitions[pollKey]
		if !ok {
			http.Error(w, "unknown poll", http.StatusBadRequest)
			return
		}
		if !pollHasOption(poll, optionKey) {
			http.Error(w, "unknown option", http.StatusBadRequest)
			return
		}

		sessionID, err := attendeeSessionID(store, w, r)
		if err != nil {
			http.Error(w, "failed to get attendee session: "+err.Error(), http.StatusInternalServerError)
			return
		}

		if err := upsertPollVote(db, pollKey, sessionID, optionKey); err != nil {
			http.Error(w, "failed to save vote: "+err.Error(), http.StatusInternalServerError)
			return
		}

		if err := publishDeckChanged(nc); err != nil {
			http.Error(w, "unable to broadcast update", http.StatusInternalServerError)
			return
		}

		w.WriteHeader(http.StatusNoContent)
	})
}

func pollVotePostURL(inviteKey, pollKey, optionKey string) string {
	escapedPoll := url.QueryEscape(pollKey)
	escapedOption := url.QueryEscape(optionKey)
	return fmt.Sprintf("@post('/%s/root/api/poll/vote?poll=%s&option=%s')", inviteKey, escapedPoll, escapedOption)
}

// pollOptionTheme is how an option looks, Kahoot style: a colour, the text colour that is readable on it,
// and a shape, so colour is never the only cue (STYLE_GUIDE.md).
type pollOptionTheme struct {
	Color     string
	TextColor string
	Badge     string
}

// kahootThemeForIndex gives options red ▲, blue ◆, yellow ●, green ■ in order. White text is only 2.4:1 on
// the yellow, so yellow gets the palette's near-black text (6.7:1); white passes on the other three.
func kahootThemeForIndex(index int) pollOptionTheme {
	const lightText, darkText = "var(--color-text-strong)", "var(--color-bg-base)"
	switch index % 4 {
	case 0:
		return pollOptionTheme{Color: "#e21b3c", TextColor: lightText, Badge: "▲"}
	case 1:
		return pollOptionTheme{Color: "#1368ce", TextColor: lightText, Badge: "◆"}
	case 2:
		return pollOptionTheme{Color: "#d89e00", TextColor: darkText, Badge: "●"}
	default:
		return pollOptionTheme{Color: "#26890c", TextColor: lightText, Badge: "■"}
	}
}

// style passes the theme to CSS as custom properties.
func (theme pollOptionTheme) style() string {
	return fmt.Sprintf("--option-color: %s; --option-text: %s;", theme.Color, theme.TextColor)
}

templ PollSlide(db *sql.DB, inviteKey string, sessionID string, poll PollDefinition) {
	{{ selectedOptionKey, _ := getMyPollVote(db, poll.Key, sessionID) }}
	<div class="slide poll">
		<div class="poll-question">
			if poll.QuestionText != "" {
				<h1>{ poll.QuestionText }</h1>
			}
			if poll.QuestionImageURL != "" {
				<img class="poll-question-image" src={ poll.QuestionImageURL } alt="Poll question image"/>
			}
			<p class="poll-hint">Pick one. You can change your vote anytime.</p>
		</div>
		<div class="poll-options">
			for i, opt := range poll.Options {
				{{ theme := kahootThemeForIndex(i) }}
				<button
					type="button"
					class="poll-option"
					style={ theme.style() }
					data-on:click={ templ.URL(pollVotePostURL(inviteKey, poll.Key, opt.Key)) }
					aria-pressed={ fmt.Sprintf("%t", opt.Key == selectedOptionKey) }
				>
					<div class="poll-option-badge">{ theme.Badge }</div>
					<div class="poll-option-body">
						if opt.ImageURL != "" {
							<img class="poll-option-image" src={ opt.ImageURL } alt=""/>
						}
						if opt.Text != "" {
							<div class="poll-option-text">{ opt.Text }</div>
						}
						if opt.Key == selectedOptionKey {
							<div class="poll-option-selected">Selected</div>
						}
					</div>
				</button>
			}
		</div>
	</div>
}
