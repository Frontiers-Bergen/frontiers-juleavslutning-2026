package root

import "github.com/frontiers-bergen/frontiers-juleavslutning-2026/components"

templ NeedKeyPage() {
	@components.BaseLayout("Frontiers Meetup", NeedKeyContent())
}

templ NeedKeyContent() {
	<main class="need-key">
		<h1>You need an invite link</h1>
		<p class="need-key-explanation">
			These slides are shared via an unlisted URL.
			Open the invite link you received (it looks like <code>/&lt;key&gt;/</code>).
		</p>
		<p class="need-key-hint">If you don’t have the link, ask the organizer in the meetup chat.</p>
	</main>
}
