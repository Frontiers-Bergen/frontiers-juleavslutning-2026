package root

import (
	"database/sql"
	"errors"
	"fmt"
	"log/slog"
	"net/http"
	"strconv"

	"github.com/frontiers-bergen/frontiers-juleavslutning-2026/pages"
	"github.com/go-chi/chi/v5"
	"github.com/gorilla/sessions"
	"github.com/nats-io/nats.go"
)

// --- DB helpers (owned by TopNavigation) ---

// currentSlideIndex is the slide everyone sees, always within the deck. The stored index can point past the
// end when the deck got shorter while the database kept the old index; showing the last slide then is better
// than a broken page.
func currentSlideIndex(db *sql.DB) (int, error) {
	var index int
	err := db.QueryRow(`SELECT current_index FROM slide_state WHERE id = 1`).Scan(&index)
	if errors.Is(err, sql.ErrNoRows) {
		return 0, nil
	}
	if err != nil {
		return 0, fmt.Errorf("failed to read the current slide: %w", err)
	}
	return clampSlideIndex(index), nil
}

func setCurrentSlideIndex(db *sql.DB, index int) error {
	_, err := db.Exec(
		`UPDATE slide_state
		 SET current_index = ?
		 WHERE id = 1`,
		index,
	)
	return err
}

// --- Routing (owned by TopNavigation) ---

func TopNavigationRoutes(router chi.Router, db *sql.DB, nc *nats.Conn, store sessions.Store, logger *slog.Logger) {
	router.Post("/slides/set", func(w http.ResponseWriter, r *http.Request) {
		// Attendees share the same invite URL as the presenter, so the URL alone proves nothing.
		if !pages.IsPresenter(r, store) {
			http.Error(w, "only the presenter can change slides", http.StatusForbidden)
			return
		}

		indexStr := r.URL.Query().Get("index")
		index, err := strconv.Atoi(indexStr)
		if err != nil {
			http.Error(w, "invalid slide index", http.StatusBadRequest)
			return
		}

		index = clampSlideIndex(index)

		if err := setCurrentSlideIndex(db, index); err != nil {
			logger.Error("failed to set slide index", slog.String("error", err.Error()))
			http.Error(w, http.StatusText(http.StatusInternalServerError), http.StatusInternalServerError)
			return
		}

		if err := publishDeckChanged(nc); err != nil {
			http.Error(w, "unable to broadcast update", http.StatusInternalServerError)
			return
		}

		w.WriteHeader(http.StatusNoContent)
	})
}

// --- Templ helper ---

// slideSetAction moves the deck to index; only the presenter's taps are accepted.
func slideSetAction(inviteKey InviteKey, index int) string {
	return postAction(inviteKey, fmt.Sprintf("/root/api/slides/set?index=%d", index))
}

templ TopNavigation(db *sql.DB, inviteKey InviteKey, sessionID SessionID) {
	{{ current, err := currentSlideIndex(db) }}
	if err != nil {
		<nav class="presenter-nav">
			<p class="presenter-nav-count">Unable to load the current slide.</p>
		</nav>
	} else {
		@topNavigation(inviteKey, current, deck(db, inviteKey, sessionID, false))
	}
}

templ topNavigation(inviteKey InviteKey, current int, deckEntries []slideEntry) {
	<nav class="presenter-nav">
		<button
			class="presenter-nav-button"
			data-on:click={ slideSetAction(inviteKey, 0) }
			aria-label="Home"
		>
			<img src="/static/house-regular-full.svg" alt="" class="presenter-nav-home-icon"/>
		</button>
		if current > 0 {
			@presenterNavPreview("Previous", inviteKey, current-1, deckEntries[current-1], false)
		} else {
			@presenterNavEdge("Previous", "This is the first slide", false)
		}
		if current+1 < len(deckEntries) {
			@presenterNavPreview("Next", inviteKey, current+1, deckEntries[current+1], true)
		} else {
			@presenterNavEdge("Next", "This is the last slide", true)
		}
		<div class="presenter-nav-count">
			Slide { fmt.Sprintf("%d / %d", current+1, len(deckEntries)) }
			if source := slideEntryAt(deckEntries, current).Source; source != "" {
				<span class="presenter-nav-source">{ source }</span>
			}
		</div>
	</nav>
}

// presenterNavPreview is a clickable preview of the slide the presenter moves to.
templ presenterNavPreview(label string, inviteKey InviteKey, targetIndex int, target slideEntry, isNext bool) {
	<div
		class={ "presenter-nav-preview", templ.KV("presenter-nav-preview-next", isNext) }
		role="button"
		tabindex="0"
		data-on:click={ slideSetAction(inviteKey, targetIndex) }
		data-on:keydown={ activatedByKeyboard(slideSetAction(inviteKey, targetIndex)) }
	>
		<div class="presenter-nav-preview-meta">
			<span class="presenter-nav-preview-label">{ label }</span>
			<span class="presenter-nav-preview-title">{ target.Title }</span>
		</div>
		<div class="slide-preview-frame">
			<div class="slide-preview-inner" inert>
				@target.Render()
			</div>
		</div>
	</div>
}

// presenterNavEdge takes the place of a preview on the first or last slide. It keeps the same size so the
// controls do not jump, but it is visibly empty and has no action: there is no slide to move to.
templ presenterNavEdge(label string, message string, isNext bool) {
	<div class={ "presenter-nav-preview", "presenter-nav-edge", templ.KV("presenter-nav-preview-next", isNext) }>
		<div class="presenter-nav-preview-meta">
			<span class="presenter-nav-preview-label">{ label }</span>
			<span class="presenter-nav-preview-title">{ message }</span>
		</div>
		<div class="slide-preview-frame"></div>
	</div>
}

// currentSlideOrNone is the current slide for the slide list, or -1 when it cannot be read: the list still works
// for moving the deck, only the highlight of the current slide is missing.
func currentSlideOrNone(db *sql.DB) int {
	current, err := currentSlideIndex(db)
	if err != nil {
		return -1
	}
	return current
}

templ PresenterSlideList(db *sql.DB, inviteKey InviteKey, sessionID SessionID) {
	{{ current := currentSlideOrNone(db) }}
	{{ deckEntries := deck(db, inviteKey, sessionID, false) }}
	<div class="presenter-slide-list">
		for i, entry := range deckEntries {
			<div
				class="presenter-slide-item"
				role="button"
				tabindex="0"
				data-active={ fmt.Sprintf("%t", current == i) }
				data-on:click={ slideSetAction(inviteKey, i) }
				data-on:keydown={ activatedByKeyboard(slideSetAction(inviteKey, i)) }
				aria-current={ fmt.Sprintf("%t", current == i) }
			>
				<div class="slide-preview-frame">
					<div class="slide-preview-inner" inert>
						@entry.Render()
					</div>
				</div>
				<div class="presenter-slide-meta">
					<span class="presenter-slide-index">{ fmt.Sprintf("%d", i+1) }</span>
					<span class="presenter-slide-title">{ entry.Title }</span>
				</div>
			</div>
		}
	</div>
}
