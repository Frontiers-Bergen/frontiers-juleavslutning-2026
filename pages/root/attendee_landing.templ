package root

type landingAvatar struct {
	value string
	label string
	emoji string
}

var landingAvatars = []landingAvatar{
	{"tree", "Tree", "🎄"},
	{"snowman", "Snowman", "⛄"},
	{"reindeer", "Reindeer", "🦌"},
	{"gift", "Gift", "🎁"},
	{"astronaut", "Astronaut", "🧑‍🚀"},
	{"firefighter", "Firefighter", "🧑‍🚒"},
	{"scientist", "Scientist", "🧑‍🔬"},
	{"artist", "Artist", "🧑‍🎨"},
	{"chef", "Chef", "🧑‍🍳"},
	{"technologist", "Technologist", "🧑‍💻"},
}

templ AttendeeLanding() {
	<main class="attendee-landing">
		<h1>Welcome!</h1>
		<p>Choose a name and an avatar for the juleavslutning.</p>
		<div class="attendee-landing-preview" aria-hidden="true">
			for _, avatar := range landingAvatars {
				<span data-avatar={ avatar.value }>{ avatar.emoji }</span>
			}
		</div>
		<label for="attendee-name">Your name</label>
		<input id="attendee-name" name="username" type="text" autocomplete="nickname"/>
		<fieldset>
			<legend>Choose your avatar</legend>
			<div class="attendee-landing-avatars">
				for _, avatar := range landingAvatars {
					<label>
						<input type="radio" name="avatar" value={ avatar.value } aria-label={ avatar.label } checked?={ avatar.value == "tree" }/>
						<span aria-hidden="true">{ avatar.emoji }</span>
					</label>
				}
			</div>
		</fieldset>
		<button type="button" disabled aria-describedby="attendee-landing-note">Continue</button>
		<p id="attendee-landing-note">WIP; can't join the deck yet.</p>
	</main>
}
