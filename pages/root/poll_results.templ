package root

import (
	"database/sql"
	"fmt"
)

type pollInviteCounts struct {
	InviteKey string
	Counts    map[string]int64
}

func getPollOptionCountsForInviteKey(db *sql.DB, pollKey string, inviteKey string) (map[string]int64, error) {
	rows, err := db.Query(`
		SELECT option_key, COUNT(*) as c
		FROM poll_votes
		WHERE poll_key = ? AND invite_key = ?
		GROUP BY option_key
	`, pollKey, inviteKey)
	if err != nil {
		return nil, err
	}
	defer rows.Close()

	counts := make(map[string]int64, 8)
	for rows.Next() {
		var optionKey string
		var c int64
		if err := rows.Scan(&optionKey, &c); err != nil {
			return nil, err
		}
		counts[optionKey] = c
	}
	if err := rows.Err(); err != nil {
		return nil, err
	}

	return counts, nil
}

func maxOptionTotal(poll PollDefinition, localCounts, remoteCounts map[string]int64) int64 {
	var max int64
	for _, opt := range poll.Options {
		t := localCounts[opt.Key] + remoteCounts[opt.Key]
		if t > max {
			max = t
		}
	}
	return max
}

var pollResultsStylesOnce = templ.NewOnceHandle()

templ PollResultsSlide(db *sql.DB, poll PollDefinition, localKey string, remoteKey string) {
	{{ localCounts, localErr := getPollOptionCountsForInviteKey(db, poll.Key, localKey) }}
	{{ remoteCounts, remoteErr := getPollOptionCountsForInviteKey(db, poll.Key, remoteKey) }}
	@pollResultsStylesOnce.Once() {
		<style>
			@layer features {
				.poll-results {
					gap: 1.25rem;
					height: 100%;

					& h1 {
						margin: 0;
					}

					.poll-results-error {
						margin: 0;
					}

					.poll-results-options {
						display: grid;
						grid-template-columns: repeat(2, minmax(0, 1fr));
						gap: 1rem;
						flex: 1;
					}

					/* Set per option: --option-color (kahootThemeForIndex), --share (width relative to the
					   top option) and --remote-share (the remote audience's part of this option's bar). */
					.poll-result {
						display: flex;
						flex-direction: column;
						gap: 0.75rem;
						padding: 1rem;
						border-radius: 18px;
						border: 2px solid rgba(0, 0, 0, 0.12);
						color: var(--color-bg-base);
						background: white;
						box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
					}

					.poll-result-header {
						display: flex;
						align-items: center;
						gap: 0.75rem;
					}

					.poll-result-badge {
						display: flex;
						align-items: center;
						justify-content: center;
						width: 3rem;
						min-width: 3rem;
						height: 3rem;
						border-radius: 14px;
						background: var(--option-color);
						color: white;
						font-size: 1.75rem;
						font-weight: 900;
					}

					.poll-result-title {
						display: flex;
						flex-direction: column;
						gap: 0.2rem;
						min-width: 0;
					}

					.poll-result-text {
						font-size: 1.15rem;
						font-weight: 900;
						line-height: 1.1;
						word-break: break-word;
					}

					.poll-result-votes {
						opacity: 0.85;
						font-weight: 800;
					}

					.poll-result-vote-count {
						font-size: 1.4rem;
					}

					.poll-result-votes-label {
						opacity: 0.8;
					}

					.poll-result-image {
						max-width: 100%;
						max-height: 16vh;
						border-radius: 14px;
						object-fit: cover;
						background: rgba(0, 0, 0, 0.04);
					}

					.poll-result-share {
						display: flex;
						flex-direction: column;
						gap: 0.35rem;
					}

					.poll-result-percent {
						align-self: flex-end;
						font-weight: 800;
					}

					.poll-result-bar {
						height: 16px;
						border-radius: 999px;
						background: rgba(0, 0, 0, 0.08);
						overflow: hidden;
					}

					.poll-result-bar-fill {
						position: relative;
						height: 100%;
						width: var(--share);
						border-radius: 999px;
						background: var(--option-color);
					}

					.poll-result-bar-remote {
						height: 100%;
						width: var(--remote-share);
						background: rgba(255, 255, 255, 0.35);
					}
				}
			}
		</style>
	}
	if localErr != nil || remoteErr != nil {
		<div class="slide poll-results">
			<h1>Poll results</h1>
			<p class="poll-results-error">Unable to load poll results.</p>
		</div>
	} else {
		{{ maxTotal := maxOptionTotal(poll, localCounts, remoteCounts) }}
		<div class="slide poll-results" data-poll-results={ poll.Key }>
			if poll.QuestionText != "" {
				<h1>{ poll.QuestionText }</h1>
			} else {
				<h1>Poll results</h1>
			}
			<div class="poll-results-options">
				for i, opt := range poll.Options {
					{{ optionColor, badge := kahootThemeForIndex(i) }}
					{{ remote := remoteCounts[opt.Key] }}
					{{ total := localCounts[opt.Key] + remote }}
					{{ share := 0.0 }}
					{{ remoteShare := 0.0 }}
					{{
						if maxTotal > 0 {
							share = float64(total) / float64(maxTotal) * 100
						}
						if total > 0 {
							remoteShare = float64(remote) / float64(total) * 100
						}
					}}
					<div
						class="poll-result"
						data-option-key={ opt.Key }
						data-vote-count={ fmt.Sprintf("%d", total) }
						style={ fmt.Sprintf("--option-color: %s; --share: %.2f%%; --remote-share: %.2f%%;", optionColor, share, remoteShare) }
					>
						<div class="poll-result-header">
							<div class="poll-result-badge">{ badge }</div>
							<div class="poll-result-title">
								if opt.Text != "" {
									<div class="poll-result-text">{ opt.Text }</div>
								}
								<div class="poll-result-votes">
									<span class="poll-result-vote-count">{ fmt.Sprintf("%d", total) }</span>
									<span class="poll-result-votes-label">votes</span>
								</div>
							</div>
						</div>
						if opt.ImageURL != "" {
							<img class="poll-result-image" src={ opt.ImageURL } alt=""/>
						}
						<div class="poll-result-share">
							<span class="poll-result-percent">{ fmt.Sprintf("%.0f%%", share) }</span>
							<div class="poll-result-bar">
								<div class="poll-result-bar-fill">
									<div class="poll-result-bar-remote"></div>
								</div>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	}
}
