package root

import (
	"database/sql"
	"errors"
	"fmt"
)

func getPollOptionCounts(db *sql.DB, pollKey string) (counts map[string]int64, err error) {
	rows, err := db.Query(`
		SELECT option_key, COUNT(*) as c
		FROM poll_votes
		WHERE poll_key = ?
		GROUP BY option_key
	`, pollKey)
	if err != nil {
		return nil, fmt.Errorf("failed to count votes: %w", err)
	}
	defer func() {
		if closeErr := rows.Close(); closeErr != nil {
			err = errors.Join(err, fmt.Errorf("failed to close vote rows: %w", closeErr))
		}
	}()

	counts = make(map[string]int64, 8)
	for rows.Next() {
		var optionKey string
		var c int64
		if err := rows.Scan(&optionKey, &c); err != nil {
			return nil, fmt.Errorf("failed to read a vote count: %w", err)
		}
		counts[optionKey] = c
	}
	if err := rows.Err(); err != nil {
		return nil, fmt.Errorf("failed to count votes: %w", err)
	}
	return counts, nil
}

func maxOptionTotal(poll PollDefinition, counts map[string]int64) int64 {
	var max int64
	for _, opt := range poll.Options {
		t := counts[opt.Key]
		if t > max {
			max = t
		}
	}
	return max
}

templ PollResultsSlide(db *sql.DB, poll PollDefinition) {
	{{ counts, countErr := getPollOptionCounts(db, poll.Key) }}
	if countErr != nil {
		<div class="slide poll-results">
			<h1>Poll results</h1>
			<p class="poll-results-error">Unable to load poll results.</p>
		</div>
	} else {
		{{ maxTotal := maxOptionTotal(poll, counts) }}
		<div class="slide poll-results" data-poll-results={ poll.Key }>
			if poll.QuestionText != "" {
				<h1>{ poll.QuestionText }</h1>
			} else {
				<h1>Poll results</h1>
			}
			<div class="poll-results-options">
				for i, opt := range poll.Options {
					{{ theme := kahootThemeForIndex(i) }}
					{{ total := counts[opt.Key] }}
					{{ share := 0.0 }}
					{{
						if maxTotal > 0 {
							share = float64(total) / float64(maxTotal) * 100
						}
					}}
					<div
						class="poll-result"
						data-option-key={ opt.Key }
						data-vote-count={ fmt.Sprintf("%d", total) }
						style={ fmt.Sprintf("%s --share: %.2f%%;", theme.style(), share) }
					>
						<div class="poll-result-header">
							<div class="poll-result-badge">{ theme.Badge }</div>
							<div class="poll-result-title">
								if opt.Text != "" {
									<div class="poll-result-text">{ opt.Text }</div>
								}
								<div class="poll-result-votes">
									<span class="poll-result-vote-count">{ fmt.Sprintf("%d", total) }</span>
									<span class="poll-result-votes-label">votes</span>
								</div>
							</div>
						</div>
						<div class="poll-result-share">
							<span class="poll-result-percent">{ fmt.Sprintf("%.0f%%", share) }</span>
							<div class="poll-result-bar">
								<div class="poll-result-bar-fill"></div>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	}
}
