package root

import (
	"database/sql"
	"fmt"

	"github.com/frontiers-bergen/frontiers-juleavslutning-2026/slides"
)

type slideEntry struct {
	Title  string
	Render func() templ.Component
}

func deck(
	db *sql.DB,
	inviteKey string,
	sessionID string,
	isPresenter bool,
	localKey string,
	remoteKey string,
) []slideEntry {
	appNamePoll := MustPoll("app-name")

	return []slideEntry{
		{Title: "Welcome", Render: func() templ.Component { return slides.Welcome(isPresenter) }},
		{Title: "Poll: " + appNamePoll.QuestionText, Render: func() templ.Component { return PollSlide(db, inviteKey, sessionID, appNamePoll) }},
		{Title: "Results: " + appNamePoll.QuestionText, Render: func() templ.Component { return PollResultsSlide(db, appNamePoll, localKey, remoteKey) }},
	}
}

func deckSize() int {
	// Only used for clamping; closures won't be executed.
	return len(deck(nil, "", "", true, "", ""))
}

func clampSlideIndex(index int) int {
	if index < 0 {
		return 0
	}

	size := deckSize()
	if size == 0 {
		return 0
	}

	if index >= size {
		return size - 1
	}

	return index
}

func slideEntryAt(deck []slideEntry, index int) slideEntry {
	if index < 0 || index >= len(deck) {
		return slideEntry{
			Title:  "Unknown slide",
			Render: func() templ.Component { return UnknownSlide() },
		}
	}
	return deck[index]
}

// --- Components ---
templ ActiveSlide(
	db *sql.DB,
	inviteKey string,
	sessionID string,
	isPresenter bool,
	localKey string,
	remoteKey string,
) {
	{{ index, _ := GetCurrentSlideIndex(db) }}
	{{ deckLocal := deck(db, inviteKey, sessionID, isPresenter, localKey, remoteKey) }}
	{{ index = clampSlideIndex(index) }}
	{{ slideComponent := slideEntryAt(deckLocal, index) }}
	<div data-signals={ fmt.Sprintf("{ slideIndex: %d }", index) }>
		@slideComponent.Render()
	</div>
}

templ UnknownSlide() {
	<p>Unknown slide</p>
}
