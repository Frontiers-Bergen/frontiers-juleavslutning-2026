package root

import (
	"database/sql"
	"fmt"

	"github.com/frontiers-bergen/frontiers-juleavslutning-2026/slides"
)

type slideEntry struct {
	Title string
	// Source is the file the slide comes from, so the presenter can find it (shown in the presenter view).
	Source string
	Render func() templ.Component
}

func deck(
	db *sql.DB,
	inviteKey string,
	sessionID string,
	isPresenter bool,
) []slideEntry {
	appNamePoll := MustPoll("app-name")
	markdown := func(name string) slideEntry {
		slide := slides.MustMarkdownSlide(name)
		return slideEntry{Title: slide.Title, Source: slide.File(), Render: func() templ.Component { return slides.Markdown(slide, isPresenter) }}
	}

	// The workshop deck, 12 November 2026: a short intro (under 15 minutes, 18:00) and show and tell at 20:30.
	return []slideEntry{
		markdown("welcome"),
		markdown("origin_story"),
		markdown("why"),
		markdown("stack"),
		markdown("live_updates"),
		markdown("what_we_learned"),
		markdown("add_a_game"),
		{Title: "Tug of war", Source: "pages/root/tug_of_war.templ", Render: func() templ.Component { return TugOfWarSlide(db, inviteKey, sessionID, isPresenter) }},
		markdown("shake_your_phone"),
		markdown("build_what_you_want"),
		markdown("get_it_running"),
		markdown("contribute"),
		markdown("lets_build"),
		markdown("show_and_tell"),
		// Not part of the talk: the app name poll was dropped from the intro, but the poll is a feature of its own
		// (the juleavslutning will use polls), and its tests and the browser check find it here.
		{Title: "Poll: " + appNamePoll.QuestionText, Source: "pages/root/poll.templ", Render: func() templ.Component { return PollSlide(db, inviteKey, sessionID, appNamePoll) }},
		{Title: "Results: " + appNamePoll.QuestionText, Source: "pages/root/poll_results.templ", Render: func() templ.Component { return PollResultsSlide(db, appNamePoll) }},
	}
}

func deckSize() int {
	// Only used for clamping; closures won't be executed.
	return len(deck(nil, "", "", true))
}

func clampSlideIndex(index int) int {
	if index < 0 {
		return 0
	}

	size := deckSize()
	if size == 0 {
		return 0
	}

	if index >= size {
		return size - 1
	}

	return index
}

func slideEntryAt(deck []slideEntry, index int) slideEntry {
	if index < 0 || index >= len(deck) {
		return slideEntry{
			Title:  "Unknown slide",
			Render: func() templ.Component { return UnknownSlide() },
		}
	}
	return deck[index]
}

// --- Components ---
templ ActiveSlide(
	db *sql.DB,
	inviteKey string,
	sessionID string,
	isPresenter bool,
) {
	{{ index, _ := GetCurrentSlideIndex(db) }}
	{{ deckLocal := deck(db, inviteKey, sessionID, isPresenter) }}
	{{ slideComponent := slideEntryAt(deckLocal, index) }}
	<div data-slide-index={ fmt.Sprint(index) }>
		@slideComponent.Render()
	</div>
}

templ UnknownSlide() {
	<p>Unknown slide</p>
}
