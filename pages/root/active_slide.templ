package root

import (
	"database/sql"
	"fmt"

	"github.com/frontiers-bergen/frontiers-juleavslutning-2026/slides"
)

type slideEntry struct {
	Title  string
	Render func() templ.Component
}

func deck(
	db *sql.DB,
	inviteKey string,
	sessionID string,
	isPresenter bool,
) []slideEntry {
	appNamePoll := MustPoll("app-name")
	markdown := func(name string) slideEntry {
		slide := slides.MustMarkdownSlide(name)
		return slideEntry{Title: slide.Title, Render: func() templ.Component { return slides.Markdown(slide, isPresenter) }}
	}

	// The workshop opening deck (draft), 12 November 2026.
	return []slideEntry{
		markdown("welcome"),
		markdown("origin_story"),
		markdown("why"),
		markdown("stack"),
		markdown("name_the_app"),
		{Title: "Poll: " + appNamePoll.QuestionText, Render: func() templ.Component { return PollSlide(db, inviteKey, sessionID, appNamePoll) }},
		{Title: "Results: " + appNamePoll.QuestionText, Render: func() templ.Component { return PollResultsSlide(db, appNamePoll) }},
		markdown("codebase"),
		markdown("live_updates"),
		markdown("add_a_game"),
		{Title: "Tug of war", Render: func() templ.Component { return TugOfWarSlide(db, inviteKey, sessionID, isPresenter) }},
		markdown("tonight"),
		markdown("house_rules"),
		markdown("lets_build"),
	}
}

func deckSize() int {
	// Only used for clamping; closures won't be executed.
	return len(deck(nil, "", "", true))
}

func clampSlideIndex(index int) int {
	if index < 0 {
		return 0
	}

	size := deckSize()
	if size == 0 {
		return 0
	}

	if index >= size {
		return size - 1
	}

	return index
}

func slideEntryAt(deck []slideEntry, index int) slideEntry {
	if index < 0 || index >= len(deck) {
		return slideEntry{
			Title:  "Unknown slide",
			Render: func() templ.Component { return UnknownSlide() },
		}
	}
	return deck[index]
}

// --- Components ---
templ ActiveSlide(
	db *sql.DB,
	inviteKey string,
	sessionID string,
	isPresenter bool,
) {
	{{ index, _ := GetCurrentSlideIndex(db) }}
	{{ deckLocal := deck(db, inviteKey, sessionID, isPresenter) }}
	{{ index = clampSlideIndex(index) }}
	{{ slideComponent := slideEntryAt(deckLocal, index) }}
	<div data-signals={ fmt.Sprintf("{ slideIndex: %d }", index) }>
		@slideComponent.Render()
	</div>
}

templ UnknownSlide() {
	<p>Unknown slide</p>
}
