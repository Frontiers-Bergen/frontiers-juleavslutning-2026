package root

import (
	"database/sql"
	"errors"
	"fmt"
	"log/slog"
	"net/http"
	"time"

	"github.com/go-chi/chi/v5"
	"github.com/gorilla/sessions"
	"github.com/nats-io/nats.go"
	"github.com/starfederation/datastar-go/datastar"
)

// Emoji reactions: every button smash deserves to count (see the Why in README.md).
//
// Counts live in the SQLite table emoji_counter and are incremented in SQL, so concurrent smashes
// cannot overwrite each other. Every smash is also published as its own NATS message on
// emojiSmashedSubject; each connected reaction bar receives every message and shows one balloon
// per smash. Do not replace this with a KV watcher: watchers deliver the latest value, which
// merges bursts of smashes into one update.

const emojiSmashedSubject = "reactions.emoji.smashed"

// reactionEmoji is one button in the reaction bar. SignalName is the Datastar signal holding its count.
type reactionEmoji struct {
	Emoji      string
	SignalName string
}

var reactionEmojis = []reactionEmoji{
	{Emoji: "👍", SignalName: "ThumbsUpEmojiCount"},
	{Emoji: "🎉", SignalName: "ConfettiEmojiCount"},
	{Emoji: "😂", SignalName: "CryLaughEmojiCount"},
	{Emoji: "🔥", SignalName: "FireEmojiCount"},
	{Emoji: "❤️", SignalName: "HeartEmojiCount"},
}

func isReactionEmoji(emoji string) bool {
	for _, reaction := range reactionEmojis {
		if reaction.Emoji == emoji {
			return true
		}
	}
	return false
}

func incrementEmojiCount(db *sql.DB, emoji string) error {
	_, err := db.Exec(`
		INSERT INTO emoji_counter (emoji, click_count) VALUES (?, 1)
		ON CONFLICT (emoji) DO UPDATE SET click_count = click_count + 1
	`, emoji)
	if err != nil {
		return fmt.Errorf("failed to increment count for %s: %w", emoji, err)
	}
	return nil
}

// emojiCountSignals returns every reaction's count keyed by its signal name, with 0 for emojis nobody has smashed yet.
func emojiCountSignals(db *sql.DB) (signals map[string]int64, err error) {
	signalNameByEmoji := map[string]string{}
	signals = map[string]int64{}
	for _, reaction := range reactionEmojis {
		signalNameByEmoji[reaction.Emoji] = reaction.SignalName
		signals[reaction.SignalName] = 0
	}

	rows, err := db.Query(`SELECT emoji, click_count FROM emoji_counter`)
	if err != nil {
		return nil, fmt.Errorf("failed to read emoji counts: %w", err)
	}
	defer func() {
		if closeErr := rows.Close(); closeErr != nil {
			err = errors.Join(err, fmt.Errorf("failed to close emoji count rows: %w", closeErr))
		}
	}()

	for rows.Next() {
		var emoji string
		var count int64
		if err := rows.Scan(&emoji, &count); err != nil {
			return nil, fmt.Errorf("failed to scan emoji count: %w", err)
		}
		if signalName, known := signalNameByEmoji[emoji]; known {
			signals[signalName] = count
		}
	}
	if err := rows.Err(); err != nil {
		return nil, fmt.Errorf("failed to read emoji counts: %w", err)
	}
	return signals, nil
}

func patchEmojiCounts(sse *datastar.ServerSentEventGenerator, db *sql.DB) error {
	signals, err := emojiCountSignals(db)
	if err != nil {
		return err
	}
	return sse.MarshalAndPatchSignals(signals)
}

// emojiBalloon is the balloon for one smash. The emoji was checked against reactionEmojis before it was published.
func emojiBalloon(smash *nats.Msg) string {
	return fmt.Sprintf(`<emoji-balloon emoji="%s"></emoji-balloon>`, string(smash.Data))
}

func EmojiReactionRoutes(router chi.Router, db *sql.DB, nc *nats.Conn, store sessions.Store, logger *slog.Logger) {
	router.Get("/emoji/sse", func(w http.ResponseWriter, r *http.Request) {
		// Subscribe before sending the initial counts, so no smash falls between the two.
		// The buffer absorbs bursts; if a phone still falls behind, NATS drops its oldest
		// balloons, but counts stay correct because they are read from the database.
		smashes := make(chan *nats.Msg, 1024)
		subscription, err := nc.ChanSubscribe(emojiSmashedSubject, smashes)
		if err != nil {
			logger.Error("failed to subscribe to emoji smashes", slog.String("error", err.Error()))
			http.Error(w, http.StatusText(http.StatusInternalServerError), http.StatusInternalServerError)
			return
		}
		defer func() {
			if err := subscription.Unsubscribe(); err != nil {
				logger.Error("failed to unsubscribe from emoji smashes", slog.String("error", err.Error()))
			}
		}()

		// NewSSE sends the response headers; from here on, failures are logged (logStreamFailure) and end the stream.
		sse := datastar.NewSSE(w, r, compressedStream())
		if err := patchEmojiCounts(sse, db); err != nil {
			logStreamFailure(logger, r, "failed to send initial emoji counts", err)
			return
		}

		for {
			select {
			case <-r.Context().Done():
				return
			case smash := <-smashes:
				// The smashes already waiting go along: one counts update and one patch with all their balloons,
				// sent at once. Nothing waits for more smashes, so no balloon is delayed; a stream that fell
				// behind catches up instead of falling further behind.
				balloons := emojiBalloon(smash)
				for range len(smashes) {
					balloons += emojiBalloon(<-smashes)
				}
				if err := patchEmojiCounts(sse, db); err != nil {
					logStreamFailure(logger, r, "failed to send emoji counts", err)
					return
				}
				if err := sse.PatchElements(balloons, datastar.WithSelector("body"), datastar.WithModeAppend()); err != nil {
					logStreamFailure(logger, r, "failed to send emoji balloon", err)
					return
				}
			}
		}
	})

	router.Post("/emoji/increment", func(w http.ResponseWriter, r *http.Request) {
		var signals struct {
			Emoji string `json:"emoji"`
		}
		if err := datastar.ReadSignals(r, &signals); err != nil {
			http.Error(w, "invalid signals", http.StatusBadRequest)
			return
		}
		if !isReactionEmoji(signals.Emoji) {
			http.Error(w, "unknown emoji", http.StatusBadRequest)
			return
		}

		if err := incrementEmojiCount(db, signals.Emoji); err != nil {
			logger.Error("failed to count emoji smash", slog.String("error", err.Error()))
			http.Error(w, http.StatusText(http.StatusInternalServerError), http.StatusInternalServerError)
			return
		}
		if err := nc.Publish(emojiSmashedSubject, []byte(signals.Emoji)); err != nil {
			logger.Error("failed to publish emoji smash", slog.String("error", err.Error()))
			http.Error(w, http.StatusText(http.StatusInternalServerError), http.StatusInternalServerError)
			return
		}

		// During a tug of war round, a smash is also a pull for the smasher's team (tug_of_war.templ).
		// The smash itself already counted, so a failure here is logged, not returned.
		sessionID, err := attendeeSessionID(store, w, r)
		if err == nil {
			err = countSmashForTugOfWar(db, nc, sessionID, time.Now())
		}
		if err != nil {
			logger.Error("failed to count smash for the tug of war", slog.String("error", err.Error()))
		}

		w.WriteHeader(http.StatusNoContent)
	})
}

templ EmojiVoteWidget(inviteKey string) {
	<div
		class="reaction-bar"
		data-init={ streamAction(inviteKey, "/root/api/emoji/sse") }
		data-on:click__stop={ postAction(inviteKey, "/root/api/emoji/increment") }
	>
		<button class="emoji-balloon-button" data-on:click="$emoji='👍';">
			<span data-text="$ThumbsUpEmojiCount"></span>
			👍
		</button>
		<button class="emoji-balloon-button" data-on:click="$emoji='🎉';">
			<span data-text="$ConfettiEmojiCount"></span>
			🎉
		</button>
		<button class="emoji-balloon-button" data-on:click="$emoji='😂';">
			<span data-text="$CryLaughEmojiCount"></span>
			😂
		</button>
		<button class="emoji-balloon-button" data-on:click="$emoji='🔥';">
			<span data-text="$FireEmojiCount"></span>
			🔥
		</button>
		<button class="emoji-balloon-button" data-on:click="$emoji='❤️';">
			<span data-text="$HeartEmojiCount"></span>
			❤️
		</button>
	</div>
}
