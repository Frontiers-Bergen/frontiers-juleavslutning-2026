package pages

import (
	"log/slog"
	"net/http"
	"strings"

	"github.com/frontiers-bergen/frontiers-juleavslutning-2026/components"
	"github.com/go-chi/chi/v5"
	"github.com/gorilla/sessions"
)

// Presenter mode: the device that knows the presenter key moves the deck and starts the games. Logging in sets a
// flag in this session cookie; IsPresenter is the one place that checks it, for every page and route.
const (
	presenterSessionName = "presenter-auth"
	presenterFlagKey     = "presenter"
)

const (
	errNone         = ""
	errInvalidForm  = "invalid_form"
	errInvalidKey   = "invalid_key"
	errEnableFailed = "enable_failed"
	errLogoutFailed = "logout_failed"
)

// PresenterRoutes serves the login page. presenterKey is the key to log in with; empty means nobody can.
func PresenterRoutes(router chi.Router, store sessions.Store, logger *slog.Logger, presenterKey string) {
	router.Route("/presenter", func(presenterRouter chi.Router) {
		presenterRouter.Get("/", func(w http.ResponseWriter, r *http.Request) {
			ctx := r.Context()

			isPresenter := IsPresenter(r, store)
			errorMessage := presenterErrorMessage(r)

			renderErr := components.BaseLayout(
				"Presenter mode",
				PresenterPage(isPresenter, errorMessage),
			).Render(ctx, w)
			if renderErr != nil {
				logger.Error("failed to render presenter page", slog.String("error", renderErr.Error()))
			}
		})

		presenterRouter.Post("/login", func(w http.ResponseWriter, r *http.Request) {
			if err := r.ParseForm(); err != nil {
				http.Redirect(w, r, "/presenter/?err="+errInvalidForm, http.StatusSeeOther)
				return
			}

			if !presenterKeyMatches(r.FormValue("key"), presenterKey) {
				http.Redirect(w, r, "/presenter/?err="+errInvalidKey, http.StatusSeeOther)
				return
			}

			if err := presenterFlagSet(w, r, store, true); err != nil {
				logger.Error("failed to enable presenter mode", slog.String("error", err.Error()))
				http.Redirect(w, r, "/presenter/?err="+errEnableFailed, http.StatusSeeOther)
				return
			}

			http.Redirect(w, r, "/presenter/", http.StatusSeeOther)
		})

		presenterRouter.Post("/logout", func(w http.ResponseWriter, r *http.Request) {
			if err := presenterFlagSet(w, r, store, false); err != nil {
				logger.Error("failed to disable presenter mode", slog.String("error", err.Error()))
				http.Redirect(w, r, "/presenter/?err="+errLogoutFailed, http.StatusSeeOther)
				return
			}

			http.Redirect(w, r, "/presenter/", http.StatusSeeOther)
		})
	})
}

// presenterKeyMatches compares the entered key with the configured one; an empty key never matches, so a server
// started without a presenter key has no presenter at all instead of letting everyone in.
func presenterKeyMatches(enteredRaw, presenterKey string) bool {
	entered := strings.TrimSpace(enteredRaw)
	expected := strings.TrimSpace(presenterKey)
	if entered == "" || expected == "" {
		return false
	}
	return entered == expected
}

// IsPresenter reports whether this device is logged in as presenter. A cookie that cannot be read (after
// SESSION_SECRET changed, or a tampered one) simply means "not presenter": that is an ordinary answer, not an error.
func IsPresenter(r *http.Request, store sessions.Store) bool {
	sess, err := store.Get(r, presenterSessionName)
	if err != nil {
		return false
	}
	enabled, ok := sess.Values[presenterFlagKey].(bool)
	return ok && enabled
}

func presenterFlagSet(w http.ResponseWriter, r *http.Request, store sessions.Store, enabled bool) error {
	sess, err := store.Get(r, presenterSessionName)
	if err != nil {
		return err
	}

	sess.Values[presenterFlagKey] = enabled
	return sess.Save(r, w)
}

func presenterErrorMessage(r *http.Request) string {
	code := strings.TrimSpace(r.URL.Query().Get("err"))

	switch code {
	case errNone:
		return ""
	case errInvalidForm:
		return "Invalid form submission."
	case errInvalidKey:
		return "Invalid presenter key."
	case errEnableFailed:
		return "Failed to enable presenter mode."
	case errLogoutFailed:
		return "Failed to log out."
	default:
		return "Something went wrong."
	}
}

templ PresenterPage(isPresenter bool, errorMessage string) {
	<div class="presenter-login">
		<h1>Presenter mode</h1>
		if errorMessage != "" {
			<div class="presenter-login-error">{ errorMessage }</div>
		}
		if !isPresenter {
			<p>Enter the presenter key to enable presenter controls on this device.</p>
			<form class="presenter-login-form" method="post" action="/presenter/login">
				<input type="password" name="key" placeholder="Presenter key" aria-label="Presenter key" autocomplete="current-password"/>
				<button type="submit">Unlock</button>
			</form>
		} else {
			<p>This device is currently in presenter mode.</p>
			<form method="post" action="/presenter/logout">
				<button type="submit">Log out presenter mode</button>
			</form>
		}
	</div>
}
