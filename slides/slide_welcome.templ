package slides

/*
Placeholder: replace with the real juleavslutning welcome slide.

Shown on the big screen while people arrive and get food.
Also the example of a plain content slide: one `.slide` element, plus presenter notes that only
the presenter sees (isPresenter).
*/

templ Welcome(isPresenter bool) {
	<div class="slide welcome">
		<img class="welcome-logo" src="/static/frontiers-logo.svg" alt="Frontiers"/>
		<h1>Frontiers Juleavslutning 2026</h1>
		<p>Starting soon. Grab some food and something to drink.</p>
	</div>
	if isPresenter {
		<div class="presenter-notes">
			<ul>
				<li>Leave this slide on screen while people arrive.</li>
				<li>Presenter notes are only visible in presenter mode.</li>
			</ul>
		</div>
	}
}
