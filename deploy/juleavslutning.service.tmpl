[Unit]
Description=Frontiers juleavslutning app (%SAFE_NAME%)
After=network.target

[Service]
User=deploy
Group=www-data
# The binary, static/ and presentation.db live here, on the server's own disk (not the Hetzner volume).
WorkingDirectory=/opt/juleavslutning/%SAFE_NAME%
# /run/juleavslutning-<name>: in memory, wiped when the service stops. NATS keeps nothing between restarts.
RuntimeDirectory=juleavslutning-%SAFE_NAME%

EnvironmentFile=/etc/juleavslutning/env
Environment=PORT=%PORT%
# Only Caddy (on the same machine) may connect; without this the app is reachable on <server IP>:<port> over plain HTTP.
Environment=HOST=127.0.0.1
Environment=NATS_STORE_DIR=/run/juleavslutning-%SAFE_NAME%/nats

ExecStart=/opt/juleavslutning/%SAFE_NAME%/juleavslutning

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
